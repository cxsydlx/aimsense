<Window x:Class="AimSense.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AimSense · 人物瞄准实验室" Width="1240" Height="740" MinWidth="1000" MinHeight="560"
 Background="#F3F3F3" Foreground="{StaticResource TextPrimary}"
 FontFamily="Segoe UI Variable Text,Segoe UI,Microsoft YaHei UI" FontSize="14"
 TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True"
 WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid x:Name="MainShell">
   <!-- 第一列**固定**为收起态宽度：导航栏展开时跨列覆盖在内容之上。
        这样动画期间布局一帧都不重排——否则整页每帧重排、训练区原生渲染面被反复 Resize，就会出现卡顿与抽搐。 -->
   <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- ===== 左栏：只做导航。收起时只有图标（52px），鼠标移入或点击后展开显示文字。 ===== -->
   <Border x:Name="NavRail" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="10" HorizontalAlignment="Left"
           Width="60" Background="#F2F3F5" ClipToBounds="True"
           MouseEnter="NavRailEnter" MouseLeave="NavRailLeave">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="18,22,18,10" Visibility="{Binding Tag, ElementName=NavList, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="AimSense" Style="{StaticResource DisplayText}"/>
      <TextBlock Text="人物瞄准实验室" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
     </StackPanel>
     <TextBlock x:Name="NavMark" Grid.Row="0" Text="A" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,16"
                Foreground="{StaticResource AccentBrush}"/>
     <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavList}" SelectionChanged="NavChanged" VerticalAlignment="Top">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}">
         <Path Style="{StaticResource NavIcon}" Data="{Binding Icon}"/>
         <TextBlock Text="{Binding Title}" Margin="12,0,0,0">
          <TextBlock.Style>
           <Style TargetType="TextBlock" BasedOn="{StaticResource NavLabel}">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
              <DataTrigger.EnterActions>
               <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                 Duration="0:0:0.16" BeginTime="0:0:0.10"/></Storyboard></BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
               <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                 Duration="0:0:0.08"/></Storyboard></BeginStoryboard>
              </DataTrigger.ExitActions>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Grid.Row="2" Margin="18,10,18,18" Style="{StaticResource Caption}" x:Name="NavFootText" Text=""
                Visibility="{Binding Tag, ElementName=NavList, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
   </Border>

   <!-- ===== 右栏：当前页 ===== -->
   <Grid Grid.Column="1" Margin="0,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Margin="0,22,28,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Text="校准测试"/>
      <TextBlock x:Name="PageCaptionText" Style="{StaticResource Caption}" Margin="0,4,0,0" Text=""/>
     </StackPanel>
     <WrapPanel Grid.Column="1" VerticalAlignment="Center">
      <Button Content="导入 JSONL" Style="{StaticResource SubtleButton}" Click="ImportTraceClicked"/>
      <Button Content="历史记录" Style="{StaticResource SubtleButton}" Click="HistoryClicked" Margin="6,4,0,4"/>
     </WrapPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,28,16">

     <!-- 页 1：校准测试（参数 + 测试区 + 结果，全在这一页） -->
     <Grid x:Name="PageTest">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="240"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Style="{StaticResource Card}" Grid.ColumnSpan="2">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="第一人称全屏校准" Style="{StaticResource SubtitleText}"/>
         <TextBlock Text="右侧参数 → 开始测试 → 下方读取推荐依据。预告、适应、切换不计分。" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
        </StackPanel>
        <Button x:Name="TestButton" Grid.Column="1" Content="开始测试" Style="{StaticResource AccentButton}" Padding="22,9" VerticalAlignment="Center" Click="TestClicked"/>
       </Grid>
      </Border>

      <Border x:Name="ArenaHost" Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource ArenaFill}" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
       <Grid x:Name="Arena" Focusable="True" Background="{StaticResource ArenaFill}" SizeChanged="ArenaSizeChanged" MouseRightButtonDown="ArenaRightClicked">
        <Viewport3D x:Name="CharacterViewport" IsHitTestVisible="False"/>
        <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False"><Line x:Name="CrosshairLeft"/><Line x:Name="CrosshairRight"/><Line x:Name="CrosshairTop"/><Line x:Name="CrosshairBottom"/><Ellipse x:Name="CrosshairDot"/></Canvas>
        <Border Background="#D9182535" CornerRadius="6" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"><StackPanel><TextBlock x:Name="ArenaStatus" Text="固定准心 · 鼠标控制视角" Foreground="White" FontSize="14"/><TextBlock x:Name="InputStatus" Foreground="#BDCFE5" FontSize="11" Margin="0,4,0,0"/><TextBlock x:Name="FrameStatus" Foreground="#A6BAD2" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
        <TextBlock x:Name="DirectionHint" Foreground="#FFE1A4" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70" IsHitTestVisible="False"/>
        <TextBlock x:Name="PhaseHint" Foreground="#FFFFFF" Background="#AA142237" Padding="14,7" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,25" IsHitTestVisible="False" Text="开始后先演示操作"/>
        <TextBlock Text="P 暂停 / 继续 · Esc / 右键结束" Foreground="#AEC0D8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" FontSize="12" IsHitTestVisible="False"/>
        <Border x:Name="InstructionOverlay" Visibility="Collapsed" Background="#EC152235" CornerRadius="8" Padding="28" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="InstructionTitle" FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="InstructionText" Foreground="#D8E4F4" FontSize="15" TextWrapping="Wrap" Margin="0,14,0,18"/></ScrollViewer><WrapPanel Grid.Row="2"><Button x:Name="ReadyButton" Content="准备完成 · Enter" Click="ReadyClicked" Style="{StaticResource AccentButton}" Margin="0,0,12,0"/><Button x:Name="DemoButton" Content="播放 / 重看演示" Click="DemoClicked"/><Button x:Name="FinishSearchButton" Content="结束，仅查看分项结果" Visibility="Collapsed" Click="FinishSearchClicked"/></WrapPanel></Grid></Border>
       </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Grid.Row="2" Grid.ColumnSpan="2" Margin="0">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="推荐依据与测试记录" Style="{StaticResource SubtitleText}"/>
        <TextBox x:Name="ResultText" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 BorderThickness="0" Background="Transparent" Padding="0" FontSize="13" Foreground="{StaticResource TextPrimary}"
                 Text="完成后显示每档表现分、命中或贴靶率、调整理由及换算公式。表现分为 0–100，越高越好，与准确率分开展示。"/>
       </Grid>
      </Border>

      <ScrollViewer Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel x:Name="SettingsPanel" Margin="0,0,6,0">
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock Text="设备与游戏" Style="{StaticResource SubtitleText}"/>
          <TextBlock Text="鼠标设备" Style="{StaticResource Field}"/><ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName"/>
          <Button Content="刷新设备与显示器" Click="RefreshClicked"/>
          <TextBlock Text="鼠标 DPI / CPI" Style="{StaticResource Field}"/><TextBox x:Name="DpiBox" Text="800" TextChanged="StartInputChanged"/>
          <TextBlock Text="填写鼠标实际档位；与 Windows 显示缩放无关。" Style="{StaticResource Hint}"/>
          <TextBlock Text="目标游戏（腰射）" Style="{StaticResource Field}"/><ComboBox x:Name="GameBox" SelectionChanged="StartInputChanged"/>
          <Expander Header="自定义 / 修正游戏换算系数（腰射 yaw）" Margin="0,10,0,0">
           <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="内置只有 4 个游戏。任何其他游戏都可以自己填：名称 + 腰射 yaw（度/计数）；同名会覆盖内置系数（例如官方改过，或你自己实测过）。不做任何猜测：没填 yaw 的游戏不参与换算。"/>
            <TextBlock Text="游戏名称（与内置同名 = 覆盖它）" Style="{StaticResource Field}"/><TextBox x:Name="CustomGameNameBox"/>
            <TextBlock Text="腰射 yaw（度/计数；CS2 0.022、Valorant 0.07、Apex 0.022、OW2 0.0066）" Style="{StaticResource Field}"/><TextBox x:Name="CustomYawBox"/>
            <TextBlock Text="类型（决定默认模式权重）" Style="{StaticResource Field}"/>
            <ComboBox x:Name="CustomFamilyBox"><ComboBoxItem Content="点击系（点击权重高）" IsSelected="True"/><ComboBoxItem Content="跟随系（跟随/移动点击权重高）"/></ComboBox>
            <TextBlock Text="可选：逐项覆盖模式权重（留空用类型默认；填了就必须三项和大于 0）" Style="{StaticResource Field}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <TextBox x:Name="CustomClickWeightBox" Margin="0,0,4,0"/><TextBox x:Name="CustomMovingWeightBox" Grid.Column="1" Margin="0,0,4,0"/><TextBox x:Name="CustomTrackWeightBox" Grid.Column="2"/></Grid>
            <TextBlock Text="依次为：点击 / 移动点击 / 跟随（例如 0.45 / 0.35 / 0.20）" Style="{StaticResource Hint}"/>
            <WrapPanel Margin="0,8,0,0">
             <Button x:Name="SaveCustomGameButton" Content="保存为自定义游戏" Style="{StaticResource AccentButton}" Click="SaveCustomGameClicked"/>
             <Button x:Name="DeleteCustomGameButton" Content="删除所选自定义游戏" Style="{StaticResource SubtleButton}" Margin="8,4,0,4" Click="DeleteCustomGameClicked"/>
            </WrapPanel>
            <TextBlock x:Name="CustomGameStatusText" Style="{StaticResource Hint}"/>
            <TextBlock Text="不知道 yaw？用你已知的一对数据反解" Style="{StaticResource Field}"/>
            <TextBlock Text="游戏内灵敏度" Style="{StaticResource Field}"/><TextBox x:Name="YawSolveSensitivityBox"/>
            <TextBlock Text="它对应的 cm/360" Style="{StaticResource Field}"/><TextBox x:Name="YawSolveCmBox"/>
            <WrapPanel Margin="0,6,0,0"><Button x:Name="SolveYawButton" Content="算出 yaw 并填入上面" Style="{StaticResource SubtleButton}" Click="SolveYawClicked"/></WrapPanel>
            <TextBlock x:Name="YawSolveStatusText" Style="{StaticResource Hint}"/>
           </StackPanel>
          </Expander>
          <TextBlock Text="当前游戏灵敏度（可留空）" Style="{StaticResource Field}"/><TextBox x:Name="SensitivityBox" TextChanged="StartInputChanged"/>
          <TextBlock Text="填写的是所选游戏的灵敏度。自动校准以此为起点，块间调整候选；计分块内固定。eDPI = DPI × 游戏灵敏度。" Style="{StaticResource Hint}"/>
          <TextBlock Text="发力方式（连续可调：纯手腕 ←→ 纯手臂）" Style="{StaticResource Field}"/>
          <Slider x:Name="WristSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="WristChanged"/>
          <TextBlock x:Name="WristReadoutText" Style="{StaticResource Hint}" Text="手腕 50% / 手臂 50%"/>
          <TextBlock Text="可用鼠标垫宽度 / cm" Style="{StaticResource Field}"/><TextBox x:Name="PadBox" Text="40" TextChanged="StartInputChanged"/>
          <TextBlock Text="搜索范围 ±%（起点上下浮动多少，10–60）" Style="{StaticResource Field}"/><TextBox x:Name="SearchRangeBox" Text="25" TextChanged="StartInputChanged"/>
          <Border Background="{StaticResource AccentSubtle}" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
           <TextBlock x:Name="StartPreviewText" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimary}" Text="填好 DPI 与垫宽后这里会显示起点 cm/360、灵敏度与 eDPI。"/>
          </Border>
          <Expander Header="可选：沿尺子校准 DPI" Margin="0,14,0,0">
           <StackPanel>
            <TextBlock Text="测量距离 / cm" Style="{StaticResource Field}"/><TextBox x:Name="DistanceBox" Text="10"/>
            <Button x:Name="CalibrationButton" Content="开始测量" Click="CalibrationClicked"/>
            <TextBlock x:Name="CalibrationText" Text="沿水平方向移动，结束后重复三次。" Style="{StaticResource Caption}"/>
           </StackPanel>
          </Expander>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock Text="真实显示模式" Style="{StaticResource SubtitleText}"/>
          <TextBlock Text="测试显示器" Style="{StaticResource Field}"/><ComboBox x:Name="DisplayBox" DisplayMemberPath="Label" SelectionChanged="DisplayChanged"/>
          <TextBlock Text="输出分辨率" Style="{StaticResource Field}"/><ComboBox x:Name="ResolutionBox" SelectionChanged="ResolutionChanged"/>
          <TextBlock Text="刷新率 / 支持的模式" Style="{StaticResource Field}"/><ComboBox x:Name="DisplayModeBox"/>
          <TextBlock x:Name="DisplayInfoText" Text="读取显示器…" Style="{StaticResource Hint}"/>
          <TextBlock Text="进入测试时临时切换，退出后恢复；更改后有 15 秒确认时间。" Style="{StaticResource Hint}"/>
          <TextBlock Text="训练场水平视场角 / °" Style="{StaticResource Field}"/><TextBox x:Name="FovBox" Text="90"/>
          <TextBlock Text="人物距离 / 人头视觉大小" Style="{StaticResource Field}"/>
          <ComboBox x:Name="CharacterDistanceBox" SelectionChanged="CharacterDistanceChanged"><ComboBoxItem Content="近距离 · 6 米"/><ComboBoxItem Content="标准距离 · 10 米" IsSelected="True"/><ComboBoxItem Content="远距离 · 16 米"/><ComboBoxItem Content="自定义距离"/></ComboBox>
          <TextBlock Text="距离 / 米（2–60）" Style="{StaticResource Field}"/><TextBox x:Name="TrainingDistanceBox" Text="10" IsEnabled="False"/>
          <TextBlock Text="头部实际尺寸固定，距离越远看起来越小。两侧标牌显示距起点的地面距离（米），外围门框数字用于辨认方向。预检可临时靠近；正式比较固定预检通过的距离。" Style="{StaticResource Hint}"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock Text="测试与准心" Style="{StaticResource SubtitleText}"/>
          <TextBlock Text="测试项目" Style="{StaticResource Field}"/><ComboBox x:Name="TestModeBox"><ComboBoxItem Content="三项分项搜索（复核另需同意）" IsSelected="True"/><ComboBoxItem Content="点击"/><ComboBoxItem Content="跟随"/><ComboBoxItem Content="移动点击"/></ComboBox>
          <TextBlock Text="第1阶段：三项分别预检与搜索，最多14轮（每轮各一块）。第2阶段：主动同意后再做18块综合复核，才有统一设置的比较依据；搜索完成不等于复核完成。" Style="{StaticResource Hint}"/>
          <TextBlock Text="准心颜色" Style="{StaticResource Field}"/><ComboBox x:Name="CrosshairColorBox"><ComboBoxItem Content="青色" IsSelected="True"/><ComboBoxItem Content="绿色"/><ComboBoxItem Content="白色"/><ComboBoxItem Content="红色"/></ComboBox>
          <TextBlock Text="线长 / 间隙 / 线宽（物理像素）" Style="{StaticResource Field}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="CrosshairLengthBox" Text="5" Margin="0,0,4,0"/><TextBox x:Name="CrosshairGapBox" Grid.Column="1" Text="3" Margin="0,0,4,0"/><TextBox x:Name="CrosshairThicknessBox" Grid.Column="2" Text="2"/></Grid>
          <CheckBox x:Name="CrosshairDotBox" Content="中心点" IsChecked="True" Margin="0,14,0,0"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </Grid>

     <!-- 页 2：手感评分 -->
     <Grid x:Name="PageFeel" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="主观手感（公式之外的标签）" Style="{StaticResource SubtitleText}"/>
         <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="为本次比较过的档位各打一个 0–10 的手感分，并标出相对开始测试时当前设置更好还是更差。手感与对局成绩不参与软件计分，只作为离线模型的标签。"/>
         <StackPanel x:Name="FeelPanel" Margin="0,16,0,0"/>
         <WrapPanel Margin="0,12,0,0">
          <Button x:Name="SaveFeelButton" Content="保存手感评分" Style="{StaticResource AccentButton}" Click="SaveFeelClicked"/>
          <Button x:Name="ClearFeelButton" Content="清空本次填写" Style="{StaticResource SubtleButton}" Margin="8,4,0,4" Click="ClearFeelClicked"/>
          <Button x:Name="RefreshLabelsButton" Content="刷新标签面板" Style="{StaticResource SubtleButton}" Margin="8,4,0,4" Click="RefreshLabelsClicked"/>
         </WrapPanel>
         <TextBlock x:Name="FeelStatusText" Style="{StaticResource Hint}"/>
         <TextBlock x:Name="FeelHistoryText" Style="{StaticResource Caption}" Margin="0,16,0,0" Text=""/>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>

     <!-- 页 3：对局成绩 -->
     <Grid x:Name="PageMatch" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="真实对局成绩（外部标签）" Style="{StaticResource SubtitleText}"/>
         <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="手工记录采用某档位后的真实成绩。它完全不来自本软件的计分公式，是判断“这个档位到底有没有用”的唯一外部依据。"/>
         <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="游戏" Style="{StaticResource Field}"/><ComboBox x:Name="MatchGameBox"><ComboBoxItem Content="CS2" IsSelected="True"/><ComboBoxItem Content="Valorant"/><ComboBoxItem Content="Apex"/><ComboBoxItem Content="OW2"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="日期（yyyy-MM-dd）" Style="{StaticResource Field}"/><TextBox x:Name="MatchDateBox"/></StackPanel>
          <StackPanel Grid.Row="1"><TextBlock Text="段位 / 评分" Style="{StaticResource Field}"/><TextBox x:Name="MatchRankBox"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="记录场次" Style="{StaticResource Field}"/><TextBox x:Name="MatchMatchesBox"/></StackPanel>
          <StackPanel Grid.Row="2"><TextBlock Text="跟枪命中率 / %" Style="{StaticResource Field}"/><TextBox x:Name="MatchTrackingBox"/></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="爆头率 / %" Style="{StaticResource Field}"/><TextBox x:Name="MatchHeadshotBox"/></StackPanel>
         </Grid>
         <TextBlock Text="使用的档位（可选，用于关联本软件推荐）" Style="{StaticResource Field}"/><ComboBox x:Name="MatchCmBox"/>
         <TextBlock Text="备注（请勿填写个人信息）" Style="{StaticResource Field}"/><TextBox x:Name="MatchNoteBox"/>
         <WrapPanel Margin="0,10,0,0"><Button x:Name="SaveMatchButton" Content="保存对局成绩" Style="{StaticResource AccentButton}" Click="SaveMatchClicked"/></WrapPanel>
         <TextBlock x:Name="MatchStatusText" Style="{StaticResource Hint}"/>
         <TextBlock Text="已记录的对局成绩" Style="{StaticResource BodyStrong}" Margin="0,18,0,6"/>
         <TextBox x:Name="MatchListText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="140" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource TextPrimary}"/>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>

     <!-- 页 4：纵向复测 -->
     <Grid x:Name="PageRetest" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="纵向留存（采用 → 复测）" Style="{StaticResource SubtitleText}"/>
         <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="采用某个档位后，本软件会记住当时的基线。以后任意一次测试只要再打到同一档位，就按同游戏、同评分版本、共同测试项目自动算出复测差值——这是“这个档位是否真的让你变好”的纵向标签。"/>
         <TextBlock Text="选择要采用的档位" Style="{StaticResource Field}"/><ComboBox x:Name="AdoptCmBox"/>
         <WrapPanel Margin="0,6,0,0"><Button x:Name="AdoptButton" Content="我采用这个档位" Style="{StaticResource AccentButton}" Click="AdoptClicked"/></WrapPanel>
         <TextBlock x:Name="AdoptStatusText" Style="{StaticResource Hint}"/>
         <TextBlock x:Name="RetestStatusText" Style="{StaticResource Caption}" Margin="0,10,0,0" Text=""/>
         <TextBlock Text="采用与复测记录" Style="{StaticResource BodyStrong}" Margin="0,18,0,6"/>
         <TextBox x:Name="AdoptListText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="140" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource TextPrimary}"/>
         <TextBlock x:Name="LabelPathText" Style="{StaticResource Hint}" Text=""/>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>

     <!-- 页 5：本地问卷 -->
     <Grid x:Name="PageSurvey" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Margin="0">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="本地问卷（只存本机，不上传）" Style="{StaticResource SubtitleText}"/>
         <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="这些是装备、习惯与经验的分层变量：将来分析“什么样的档位适合什么样的人”时要用它们，而不是让模型把硬件差异学成个人能力。"/>
         <Border Background="{StaticResource AccentSubtle}" CornerRadius="4" Padding="12,9" Margin="0,12,0,0">
          <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimary}" Text="当前版本没有任何上传功能：本页只写入本机标签文件的 profile 记录。以后若要上传（含征求同意、随时撤回、请求删除），会在你明确同意后单独做，并在上传前逐字段展示将要发送什么。"/>
         </Border>
         <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="主玩游戏" Style="{StaticResource Field}"/><ComboBox x:Name="SurveyGameBox"><ComboBoxItem Content="CS2" IsSelected="True"/><ComboBoxItem Content="Valorant"/><ComboBoxItem Content="Apex"/><ComboBoxItem Content="OW2"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="鼠标垫类型" Style="{StaticResource Field}"/><ComboBox x:Name="SurveyPadTypeBox"><ComboBoxItem Content="布垫" IsSelected="True"/><ComboBoxItem Content="硬垫"/><ComboBoxItem Content="混合垫"/><ComboBoxItem Content="其他 / 不确定"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="1"><TextBlock Text="鼠标型号（可留空）" Style="{StaticResource Field}"/><TextBox x:Name="SurveyMouseBox"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="鼠标重量 / g（可留空）" Style="{StaticResource Field}"/><TextBox x:Name="SurveyWeightBox"/></StackPanel>
          <StackPanel Grid.Row="2"><TextBlock Text="握法" Style="{StaticResource Field}"/><ComboBox x:Name="SurveyGripBox"><ComboBoxItem Content="掌握" IsSelected="True"/><ComboBoxItem Content="指握"/><ComboBoxItem Content="爪握"/><ComboBoxItem Content="混合"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="年龄区间（可留空）" Style="{StaticResource Field}"/><ComboBox x:Name="SurveyAgeBox"><ComboBoxItem Content="不透露" IsSelected="True"/><ComboBoxItem Content="14–17"/><ComboBoxItem Content="18–24"/><ComboBoxItem Content="25–34"/><ComboBoxItem Content="35 以上"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="3"><TextBlock Text="FPS 游戏年限" Style="{StaticResource Field}"/><TextBox x:Name="SurveyFpsYearsBox"/></StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="瞄准训练月数" Style="{StaticResource Field}"/><TextBox x:Name="SurveyTrainingBox"/></StackPanel>
          <StackPanel Grid.Row="4"><TextBlock Text="每周游戏时长 / 小时" Style="{StaticResource Field}"/><TextBox x:Name="SurveyWeeklyHoursBox"/></StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="备注（请勿填写个人信息）" Style="{StaticResource Field}"/><TextBox x:Name="SurveyNoteBox"/></StackPanel>
         </Grid>
         <TextBlock Style="{StaticResource Hint}" Text="DPI、发力方式、垫子宽度、显示器刷新率会从“校准测试”页的设置自动带上，作为填写当时的快照。"/>
         <WrapPanel Margin="0,10,0,0">
          <Button x:Name="SaveSurveyButton" Content="保存问卷（本机）" Style="{StaticResource AccentButton}" Click="SaveSurveyClicked"/>
          <Button x:Name="OpenDataFolderButton" Content="打开本机数据文件夹" Style="{StaticResource SubtleButton}" Margin="8,4,0,4" Click="OpenDataFolderClicked"/>
         </WrapPanel>
         <TextBlock x:Name="SurveyStatusText" Style="{StaticResource Hint}"/>
         <TextBlock Text="本机采集规模" Style="{StaticResource BodyStrong}" Margin="0,18,0,6"/>
         <TextBlock x:Name="LocalDataText" Style="{StaticResource Caption}" Text=""/>
         <TextBlock Text="最近一次问卷" Style="{StaticResource BodyStrong}" Margin="0,14,0,6"/>
         <TextBlock x:Name="SurveyHistoryText" Style="{StaticResource Caption}" Text=""/>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>

     <!-- 页 6：数据与隐私（原独立窗口改为导航页） -->
     <Grid x:Name="PagePrivacy" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimary}"
                   Text="⚠ 当前版本没有任何联网上传代码：本页只把“将来可能发送的内容”在本机拼出来给你看，并允许导出成文件自查。真正上传必须先有定稿的告知书和你逐项同意。"/>
        <TextBlock x:Name="PrivacyStatusText" Grid.Row="1" Style="{StaticResource Hint}"/>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
         <StackPanel Margin="0,10,0,0">
          <CheckBox x:Name="ScopeSessionBox" Content="会话聚合（设置 + 候选档位特征）" IsChecked="True" Margin="0,0,0,9"/>
          <CheckBox x:Name="ScopeLabelsBox" Content="标签（手感 / 对局成绩 / 采用 / 复测）" IsChecked="True" Margin="0,0,0,9"/>
          <CheckBox x:Name="ScopeSurveyBox" Content="本地问卷（装备 / 习惯 / 经验 / 年龄区间）" IsChecked="True"/>
         </StackPanel>
         <WrapPanel Margin="0,10,0,0">
          <Button x:Name="PreviewPrivacyButton" Content="生成预览" Style="{StaticResource AccentButton}" Click="PrivacyPreviewClicked"/>
          <Button x:Name="ExportPreviewButton" Content="导出预览到文件（仅本机）" Style="{StaticResource SubtleButton}" Margin="8,4,0,4" Click="PrivacyExportClicked"/>
          <Button x:Name="CopyPreviewButton" Content="复制到剪贴板" Style="{StaticResource SubtleButton}" Margin="8,4,0,4" Click="PrivacyCopyClicked"/>
         </WrapPanel>
         <TextBlock Text="将要发送的内容（预览）" Style="{StaticResource BodyStrong}" Margin="0,14,0,6"/>
        </StackPanel>
        <TextBox x:Name="PrivacyPreviewText" Grid.Row="3" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0"
                 FontFamily="Consolas,Cascadia Mono,Microsoft YaHei UI" FontSize="12"/>
       </Grid>
      </Border>
      <Border Style="{StaticResource Card}" Grid.Column="2" Margin="0">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="本机数据与匿名 ID" Style="{StaticResource SubtitleText}"/>
         <TextBlock x:Name="InstallIdText" Style="{StaticResource Caption}" Margin="0,10,0,0" Text=""/>
         <WrapPanel Margin="0,8,0,0">
          <Button x:Name="ResetIdButton" Content="重置匿名安装 ID" Style="{StaticResource SubtleButton}" Click="PrivacyResetIdClicked"/>
          <Button x:Name="PrivacyOpenFolderButton" Content="打开数据文件夹" Style="{StaticResource SubtleButton}" Margin="8,4,0,4" Click="OpenDataFolderClicked"/>
         </WrapPanel>
         <TextBlock Text="剥字段规则" Style="{StaticResource BodyStrong}" Margin="0,16,0,6"/>
         <TextBlock Style="{StaticResource Caption}" Text="• 逐字段白名单：新增字段不会自动进入上传包，必须显式加白名单。"/>
         <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="• 构建后立刻做一次禁传键递归扫描，命中即拒绝生成（宁可崩在本地，也不发脏包）。"/>
         <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="• 原始逐帧轨迹（DX/DY、视角、人物坐标、事件流）、设备标识、屏幕几何、本地路径、自由文本备注一律不上传。"/>
         <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="• 段位名改为数值评分；安装 ID 是随机数、可一键重置。"/>
         <TextBlock x:Name="RedactionText" Style="{StaticResource Caption}" Margin="0,14,0,0" Text=""/>
         <TextBlock Text="撤回与删除（只作用于本机）" Style="{StaticResource BodyStrong}" Margin="0,18,0,6"/>
         <TextBlock x:Name="LocalDataSummaryText" Style="{StaticResource Caption}" Text=""/>
         <CheckBox x:Name="DeleteLabelsBox" Content="标签（手感 / 对局 / 采用 / 复测 / 问卷 / 会话快照）" Margin="0,0,0,9"/>
         <CheckBox x:Name="DeleteTracesBox" Content="轨迹与历史记录（会丢失全部测量记录，不可恢复）" Margin="0,0,0,9"/>
         <CheckBox x:Name="DeletePreviewsBox" Content="上传预览导出文件" Margin="0,0,0,9"/>
         <CheckBox x:Name="DeleteInstallIdBox" Content="匿名安装 ID（换新 ID，与历史数据断开）"/>
         <WrapPanel Margin="0,8,0,0"><Button x:Name="DeleteDataButton" Content="删除所选本机数据…" Style="{StaticResource SubtleButton}" Click="DeleteDataClicked"/></WrapPanel>
         <TextBlock Style="{StaticResource Hint}" Text="上传功能尚未实现，因此现在没有“服务端数据”可删；一旦真正上传，撤回同意会同时触发服务端删除并给你回执。"/>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>

    </Grid>

    <TextBlock Grid.Row="2" Margin="0,0,28,14" Style="{StaticResource Hint}" Text="只调整本软件灵敏度；输出对应游戏的腰射设置。结果是已测试候选的比较，不代表全局最优。手感、对局成绩、复测与问卷只作为离线标签，不改变计分与推荐。"/>
   </Grid>
  </Grid>
  <Grid x:Name="FullScreenLayer" Background="{StaticResource ArenaFill}" Visibility="Collapsed"/>
 </Grid>
</Window>
