<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>AimSense-1.1.2-x64</OutputName>
    <OutputType>Package</OutputType>
    <!-- 发布目录由命令行传入：dotnet build -p:PublishDir=<绝对路径>；
         在 .wxs 里用预处理器变量 $(var.PublishDir) 引用。
         ※ WiX v5 的 bindpath（!(bindpath.x)）实测没生效，会被当成字面字符串，所以用 DefineConstants。
         ※ 构建必须指定 -p:Platform=x64，否则可能解析到 arm64 版原生工具（x64 机器上起不来）。 -->
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>
</Project>
